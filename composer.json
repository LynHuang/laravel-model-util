{
  "name": "lyn_huang/laravel-model-util",
  "type": "library",
  "description": "Laravel 常用模型工具集：请求过滤器、批量更新/插入等开箱即用能力",
  "keywords": [
    "laravel",
    "laravel-model",
    "filter",
    "batch",
    "eloquent"
  ],
  "license": "MIT",
  "require": {
    "php": "^7.3|^8.0",
    "laravel/framework": "^8.0|^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^4.0|^5.0|^6.0|^7.0|^8.0|^9.0",
    "phpunit/phpunit": "^8.0|^9.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "LynHuang\\LaravelModelUtil\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LynHuang\\LaravelModelUtil\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LynHuang\\LaravelModelUtil\\ModelUtilServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Lyn Huang"
    }
  ],
  "support": {
    "issues": "https://github.com/lyn-huang/laravel-model-util/issues",
    "source": "https://github.com/lyn-huang/laravel-model-util"
  }
}
